# ─────────────────────────────────────────────────────────────────────────
# enten monorepo — example environment file.
#
# Copy to `.env` (which is git-ignored) and fill in real values.
# The Python core reads these via `enten.config.Settings`; the TS edge
# reads them via `@enten/app`'s `parse()` after `dotenv.config()`.
# Variables in this file are intentionally grouped by the language /
# component that consumes them; both sides tolerate missing values
# for the optional ones, but the agent will refuse to start without
# GITHUB_APP_ID, GITHUB_WEBHOOK_SECRET, and DATABASE_URL on the TS
# side. The default production worker does not invoke an LLM.
# ─────────────────────────────────────────────────────────────────────────

# ── GitHub App identity (Py core + TS edge) ──────────────────────────────
# Numeric App ID from the GitHub App's "About" page.
GITHUB_APP_ID=1
# Public slug shown in installation URLs.
GITHUB_APP_SLUG=enten-bot
# Filesystem path to the PEM key downloaded from the App's "Private
# keys" page. Inline the path, never the key.
GITHUB_APP_PRIVATE_KEY_PATH=/etc/enten/github-app.pem
# Shared secret used to validate `X-Hub-Signature-256` on inbound
# webhooks. Generate with `openssl rand -hex 32`.
GITHUB_WEBHOOK_SECRET=local-development-only
# Email the agent uses when pushing fix branches; used to self-ignore
# in cron/diff jobs.
COMMITTER_EMAIL=enten-bot@example.com

# ── LLM provider (Py core) ───────────────────────────────────────────────
# Either `openai-compat` or `ollama`.
LLM_PROVIDER=openai-compat
# Default chat model. Per-task overrides live in the planner.
LLM_DEFAULT_MODEL=gpt-4o-mini
# Hard cap on ReAct-style iterations per task.
LLM_MAX_ITERATIONS=15
# OpenAI-compatible base URL; covers OpenAI, Together, vLLM, etc.
LLM_OPENAI_BASE_URL=https://api.openai.com/v1
# API key for the OpenAI-compatible provider. `sk-...` is the OpenAI
# prefix; other vendors use their own shapes.
LLM_OPENAI_API_KEY=sk-...
# Ollama's local daemon; only consulted when LLM_PROVIDER=ollama.
LLM_OLLAMA_BASE_URL=http://localhost:11434

# ── Embeddings (Py core) ─────────────────────────────────────────────────
# OpenAI-compatible embeddings endpoint. Falls back to LLM_OPENAI_BASE_URL
# and LLM_OPENAI_API_KEY when omitted.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
# Model must be compatible with the vec.chunks vector dimension (1024).
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1024
EMBEDDING_TIMEOUT=30.0
EMBEDDING_BATCH_SIZE=64

# ── Sandbox provider (Py core) ───────────────────────────────────────────
# Docker is the only verified release backend. Selecting `e2b` fails closed.
SANDBOX_PROVIDER=docker
# Trusted verifier image and argv-only command. Use an immutable digest in
# production; the defaults are only a Python syntax smoke check.
SANDBOX_DOCKER_IMAGE=python:3.12-slim@sha256:c3d81d25b3154142b0b42eb1e61300024426268edeb5b5a26dd7ddf64d9daf28
VERIFICATION_COMMAND=python -m compileall -q .

# ── Database (Py core + TS edge) ─────────────────────────────────────────
# SQLAlchemy-style URL on the Python side; the queue/migration boundary
# normalizes it for asyncpg. The TypeScript edge accepts the same value.
DATABASE_URL=postgresql+asyncpg://enten:enten@localhost/enten

# ── Cost & diff guardrails (Py core) ─────────────────────────────────────
# Token budget for a single PR's diff; over-budget diffs are rejected
# before they hit the LLM.
MAX_PR_DIFF_TOKENS=50000
# USD per-PR cap enforced by the LLM client.
PER_PR_COST_CAP_USD=0.50

# ── Observability (Py core + TS edge) ────────────────────────────────────
# OTLP gRPC endpoint for the OTel SDK.
OTEL_ENDPOINT=http://localhost:4317
# Port the Python Prometheus exposition listens on.
PROMETHEUS_METRICS_PORT=9090
# Port the TS edge Prometheus exposition listens on (different from
# the Python one so both can run on a single dev host).
METRICS_PORT=9091
# HTTP listen port for the TS edge (Hono).
PORT=3000
