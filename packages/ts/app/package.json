{
  "name": "@enten/app",
  "version": "0.1.0",
  "private": true,
  "description": "enten HTTP/webhook entry point (Hono, Node 22).",
  "type": "module",
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@octokit/webhooks": "^14.0.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.78.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.220.0",
    "@opentelemetry/sdk-node": "^0.220.0",
    "dotenv": "^17.4.2",
    "hono": "^4.13.14",
    "pino": "^9.5.0",
    "postgres": "^3.4.9",
    "prom-client": "^15.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/ui": "5.0.5",
    "msw": "^2.6.0",
    "nock": "^14.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
