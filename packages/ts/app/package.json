{
  "name": "@enten/app",
  "version": "0.1.0",
  "private": true,
  "description": "enten HTTP/webhook entry point (Hono, Node 22).",
  "type": "module",
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "echo 'lint: not configured (T07 will add eslint/biome)'",
    "format": "echo 'format: not configured (T07 will add prettier/biome)'",
    "format:check": "echo 'format:check: not configured (T07)'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@octokit/webhooks": "^14.0.0",
    "@opentelemetry/sdk-node": "^0.55.0",
    "dotenv": "^17.4.2",
    "hono": "^4.6.0",
    "pino": "^9.5.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^2.1.0",
    "@vitest/ui": "^2.1.0",
    "msw": "^2.6.0",
    "nock": "^14.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
