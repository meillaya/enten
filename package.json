{
  "name": "enten-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "enten - AI engineering agent (bilingual Python+TypeScript monorepo)",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/ts/*' build",
    "test": "pnpm -r --filter './packages/ts/*' test",
    "test:ts": "pnpm -r --filter './packages/ts/*' test",
    "lint": "pnpm -r --filter './packages/ts/*' lint",
    "format": "pnpm -r --filter './packages/ts/*' format",
    "format:check": "pnpm -r --filter './packages/ts/*' format:check",
    "typecheck": "pnpm -r --filter './packages/ts/*' typecheck",
    "coverage": "pnpm -r --filter './packages/ts/*' coverage",
    "dev": "pnpm -r --parallel --filter './packages/ts/*' dev"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
